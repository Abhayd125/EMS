datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  name               String
  role               Role      @default(EMPLOYEE)
  isVerified         Boolean   @default(false)
  verificationToken  String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  refreshToken       String?
  employee           Employee?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([email])
}

model Employee {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  phone            String
  address          String
  profileImage     String?
  resume           String?
  documents        String?           // JSON string of document paths
  departmentId     Int
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  skills           Skill[]           @relation("EmployeeSkills")
  userId           Int?              @unique
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  managerId        Int?
  manager          Employee?         @relation("ManagerEmployees", fields: [managerId], references: [id])
  subordinates     Employee[]        @relation("ManagerEmployees")
  leaveRequests    LeaveRequest[]
  leaveBalance     LeaveBalance?
  assetAssignments AssetAssignment[]
  notifications    Notification[]
  attendance       Attendance[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([email])
  @@index([managerId])
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Skill {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[] @relation("EmployeeSkills")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model LeaveRequest {
  id             Int        @id @default(autoincrement())
  employeeId     Int
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      String     // "SICK", "CASUAL", "PAID"
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         String     @default("PENDING_MANAGER") // "PENDING_MANAGER", "PENDING_HR", "APPROVED", "REJECTED"
  managerComment String?
  hrComment      String?
  auditLogs      AuditLog[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([employeeId])
  @@index([status])
}

model LeaveBalance {
  id         Int      @id @default(autoincrement())
  employeeId Int      @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sick       Int      @default(12)
  casual     Int      @default(15)
  paid       Int      @default(20)
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id             Int          @id @default(autoincrement())
  leaveRequestId Int
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  action         String       // "APPLIED", "MANAGER_APPROVED", "HR_APPROVED", "REJECTED"
  actorId        Int
  actorName      String
  comment        String?
  createdAt      DateTime     @default(now())
}

model Asset {
  id           Int               @id @default(autoincrement())
  name         String
  serialNumber String            @unique
  type         String            // "LAPTOP", "MONITOR", "ID_CARD", "OTHER"
  status       String            @default("AVAILABLE") // "AVAILABLE", "ASSIGNED", "UNDER_REPAIR", "RETIRED"
  assignments  AssetAssignment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([serialNumber])
  @@index([status])
}

model AssetAssignment {
  id         Int       @id @default(autoincrement())
  assetId    Int
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  status     String    @default("ACTIVE") // "ACTIVE", "RETURNED"
  notes      String?

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
}

model Notification {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String   // "LEAVE", "ASSET", "SYSTEM"
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([isRead])
}

model AuditTrail {
  id        Int      @id @default(autoincrement())
  tableName String
  recordId  Int
  action    String   // "CREATE", "UPDATE", "DELETE"
  oldValues Json?
  newValues Json?
  actorId   Int?
  actorName String?
  createdAt DateTime @default(now())

  @@index([tableName, recordId])
}

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String    // format "YYYY-MM-DD"
  checkIn    DateTime  @default(now())
  checkOut   DateTime?
  status     String    @default("PRESENT") // "PRESENT", "ABSENT", "LATE"
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}
